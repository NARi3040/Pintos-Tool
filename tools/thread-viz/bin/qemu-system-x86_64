#!/usr/bin/env bash
# run.sh가 PATH 맨 앞에 두는 QEMU 래퍼. RR=record|replay, RR_FILE=<기록 파일>, GDB_PORT=<포트>
# GDB_PORT: pintos --gdb가 붙이는 -s(포트 1234 고정)를 이 포트로 바꿈. 테스트를 동시에 돌릴 때 포트가 안 겹치게 함
# record: gdb 없이 실제로 돌린 실행을 기록함 (이 출력으로 채점)
# replay: 기록을 그대로 재생함. gdb 훅으로 멈춰도 가상 시간과 인터럽트 시점이 기록과 똑같아서, 트레이스가 채점한 실행과 일치함
# 기록/재생에는 디스크를 blkreplay로 감싸야 해서, pintos가 넘긴 -drive file=...,index=N 인자를 같은 IDE 위치(N/2번 버스, N%2번 유닛)로 바꿔 끼움
# 디스크는 기록할 때 qcow2로 떠서 RR_FILE 옆(<기록>.d<N>.qcow2)에 남기고, 시작 시점 스냅샷(init)을 같이 저장함.
# 재생은 그 qcow2와 스냅샷에서 시작하므로 pintos가 새로 만든 임시 디스크와 상관없음.
# 기록 중에는 2초마다 스냅샷(s1, s2, ...)도 남김. 디버거(debug.py)는 RRSNAP=<스냅샷>으로 목표 지점 직전 스냅샷에서 재생을 시작해서
# 부팅부터 다시 돌리지 않고 빨리 이동/되감기함. (QEMU 안에서 실행 중에 중간 스냅샷을 불러오는 replay_seek/reverse-step은
# 6.2와 10.2 모두 멈춰서 안 씀. 새 QEMU를 스냅샷에서 시작하는 건 됨)
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
PATH="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$SELF_DIR" | paste -sd:)"

args=() prev=""
for a in "$@"; do
    if [[ $a == -s && -n ${GDB_PORT:-} ]]; then
        args+=(-gdb "tcp:127.0.0.1:$GDB_PORT")
    elif [[ -n ${RR:-} && $prev == -drive && $a == file=*index=* ]]; then
        f=${a#file=}; f=${f%%,*}; n=${a##*index=}; n=${n%%,*}
        args=("${args[@]:0:${#args[@]}-1}")   # 앞에 넣은 -drive 제거
        q="$RR_FILE.d$n.qcow2"
        if [ "$RR" = record ]; then qemu-img convert -O qcow2 "$f" "$q" || exit 1; fi
        [ -f "$q" ] || { echo "qemu 래퍼: 기록된 디스크 $q 가 없음. 테스트를 다시 실행할 것" >&2; exit 1; }
        args+=(-drive "file=$q,format=qcow2,if=none,id=d$n"
               -drive "driver=blkreplay,if=none,image=d$n,id=r$n"
               -device "ide-hd,drive=r$n,bus=ide.$((n / 2)),unit=$((n % 2))")
    else
        args+=("$a")
    fi
    prev=$a
done
[ -z "${RR:-}" ] && exec qemu-system-x86_64 "${args[@]}"
mon=()
if [ "$RR" = record ]; then
    sock="$(mktemp -u /tmp/tvz-mon.XXXXXX)"   # 유닉스 소켓 경로는 108자 제한이라 짧은 곳에 둠
    mon=(-monitor "unix:$sock,server=on,wait=off")
    # QEMU가 끝나 소켓이 닫히면 같이 끝남. "지금은 스냅샷을 못 만듦"이면 잠깐 뒤 다시 시도
    python3 - "$sock" > /dev/null 2>&1 <<'PY' &
import socket, sys, time, os
s = socket.socket(socket.AF_UNIX)
for _ in range(300):
    try:
        s.connect(sys.argv[1]); break
    except OSError:
        time.sleep(0.1)
else:
    sys.exit()
os.unlink(sys.argv[1])
s.settimeout(5)
buf = b""
def cmd(c):
    """명령을 보내고 다음 (qemu) 프롬프트까지 읽음"""
    global buf
    if c:
        s.sendall(c.encode() + b"\n")
    while b"(qemu) " not in buf:
        d = s.recv(65536)
        if not d:
            raise OSError
        buf += d
    out, _, buf = buf.partition(b"(qemu) ")
    return out
try:
    cmd("")
    # 디스크 요청이 진행 중이면 거부되므로 될 때까지 짧게 다시 시도함 (디스크를 많이 쓰는 구간에도 스냅샷이 생기게)
    for k in range(1, 61):   # 스냅샷 하나가 1MB 안팎이라 개수를 제한함
        time.sleep(2)
        while b"not allow" in cmd("savevm s%d" % k):
            time.sleep(0.02)
except OSError:
    pass
PY
fi
# shift=auto: 가상 시간이 실제 시간을 따라가서 make check와 타이밍이 비슷함. 기록 모드에선 그 흐름이 기록되므로 재생은 결정적임
# -net none: 기본 NIC(PXE 롬)는 기록/재생을 지원 안 함
exec qemu-system-x86_64 "${args[@]}" ${mon[@]+"${mon[@]}"} -net none -icount "shift=auto,rr=$RR,rrfile=$RR_FILE,rrsnapshot=${RRSNAP:-init}"
